{
  "manifest_version": 3,
  "name": "UOKey",
  "version": "0.14.0",
  "description": "Use Only Keyboard: press Ctrl+Space, type the text of a link, button or field, then press Enter to click it.",
  "permissions": ["bookmarks", "browserSettings", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": ["background.js"]
  },
  "commands": {
    "toggle-finder": {
      "suggested_key": {
        "default": "Ctrl+Space"
      },
      "description": "Open or close the UOKey search bar"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "uokey@kalatz",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
